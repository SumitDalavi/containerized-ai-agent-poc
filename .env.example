# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: containerized-ai-agent-poc
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - No OpenAI API key required.
# - System runs in Mock Mode using deterministic, rule-based responses and sandboxed execution.
#
# TIER 2: LOCAL DEV WITH LIVE AI
# - Supply an OpenAI API key (sk-...) to activate live GPT-4o-mini tool execution
#   and real-time LLM reasoning loops.
#
# TIER 3: PRODUCTION KUBERNETES DEPLOYMENT
# - Inject credentials via Kubernetes Secrets or Helm values.
#
# ── AI Provider ──────────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic rule-based mock responses
# SET to real sk-... key: Live GPT-4o-mini agent reasoning and completion
OPENAI_API_KEY=

# ── Agent Configuration ──────────────────────────────────────────────────────
AGENT_PROMPT=What is the status of the cluster?
AGENT_WORKSPACE=./workspace
PORT=8000
